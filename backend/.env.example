# API Server
PORT=8000
HOST=0.0.0.0
ENV=development

# LLM Providers (前端未配置或配置项缺少时，自动采用如下系统默认配置)
DEFAULT_PROVIDER=gemini

# Google Gemini 跨境反代默认配置
GEMINI_BASE_URL=https://gemini.trythis.pw/v1
GEMINI_MODEL=models/gemini-flash-latest
GEMINI_API_KEY=your_gemini_api_key_here

# Aliyun DashScope (可选国内备用通道)
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen-vl-plus

# Timeout Settings
PRIMARY_TIMEOUT_SECONDS=35.0
SECONDARY_TIMEOUT_SECONDS=25.0
