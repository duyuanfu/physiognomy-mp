# API Server
PORT=8000
HOST=0.0.0.0
ENV=development

# LLM Providers
DEFAULT_PROVIDER=gemini # "gemini" or "qwen"

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash-8b
# HTTPS proxy if required inside China, e.g. http://127.0.0.1:7890
HTTPS_PROXY=

# Aliyun DashScope (Qwen)
DASHSCOPE_API_KEY=your_dashscope_api_key_here
QWEN_MODEL=qwen-vl-plus

# Timeout Settings
PRIMARY_TIMEOUT_SECONDS=6.0
SECONDARY_TIMEOUT_SECONDS=10.0
